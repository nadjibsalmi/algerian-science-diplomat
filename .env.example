# ═══════════════════════════════════════════════════════════════════
# ASD — Algerian Science Diplomat — Configuration d'environnement
# ═══════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez TOUTES les valeurs marquées
# d'un ⚠️  avant de démarrer l'application en production.
# ═══════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────
APP_NAME="Algerian Science Diplomat"
APP_ENV=local                   # local | staging | production
APP_KEY=                        # ⚠️  Généré par: php artisan key:generate
APP_DEBUG=true                  # ⚠️  TOUJOURS false en production
APP_URL=http://localhost
APP_PORT=80
APP_SSL_PORT=443

APP_LOCALE=fr                   # fr | ar | en
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_TIMEZONE=Africa/Algiers

# ─── Logs ────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                 # debug | info | warning | error (prod: error)

# ─── Base de données (PostgreSQL 17) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres                # 'postgres' avec Docker, '127.0.0.1' sans
DB_PORT=5432
DB_DATABASE=asd_platform
DB_USERNAME=postgres
DB_PASSWORD=                    # ⚠️  Mot de passe fort obligatoire

# ─── Sessions ────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120            # Minutes d'inactivité avant expiration
SESSION_ENCRYPT=false           # ⚠️  true en production
SESSION_COOKIE_SECURE=false     # ⚠️  true en production (HTTPS)
SESSION_COOKIE_SAME_SITE=lax

# ─── Cache (Redis) ───────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=asd

REDIS_CLIENT=phpredis
REDIS_HOST=redis                # 'redis' avec Docker, '127.0.0.1' sans
REDIS_PORT=6379
REDIS_PASSWORD=                 # ⚠️  Mot de passe Redis obligatoire
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Queue (Laravel Horizon + Redis) ─────────────────────────────────
QUEUE_CONNECTION=redis
HORIZON_BALANCE_STRATEGY=auto
HORIZON_MIN_PROCESSES=1
HORIZON_MAX_PROCESSES=5

# ─── Broadcasting (Laravel Reverb) ───────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=asd_app
REVERB_APP_KEY=                 # ⚠️  Clé aléatoire longue
REVERB_APP_SECRET=              # ⚠️  Secret aléatoire long
REVERB_HOST=reverb              # 'reverb' avec Docker
REVERB_PORT=8080
REVERB_SCHEME=http              # https en production

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Email ───────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit               # 'mailpit' en dev, votre SMTP en prod
MAIL_PORT=1025                  # 1025 Mailpit | 587 SMTP prod
MAIL_USERNAME=null
MAIL_PASSWORD=null              # ⚠️  Mot de passe SMTP en prod
MAIL_ENCRYPTION=null            # null en dev | tls en prod
MAIL_FROM_ADDRESS="noreply@asd.dz"
MAIL_FROM_NAME="Algerian Science Diplomat"

# ─── Stockage fichiers (MinIO / S3) ──────────────────────────────────
FILESYSTEM_DISK=s3

MINIO_ENDPOINT=http://minio:9000  # ⚠️  URL publique en prod
MINIO_ACCESS_KEY=                 # ⚠️  Clé d'accès MinIO
MINIO_SECRET_KEY=                 # ⚠️  Clé secrète MinIO
MINIO_BUCKET=asd-documents
MINIO_REGION=us-east-1

# Variables AWS standard (utilisées par Laravel Flysystem S3)
AWS_ACCESS_KEY_ID="${MINIO_ACCESS_KEY}"
AWS_SECRET_ACCESS_KEY="${MINIO_SECRET_KEY}"
AWS_DEFAULT_REGION="${MINIO_REGION}"
AWS_BUCKET="${MINIO_BUCKET}"
AWS_ENDPOINT="${MINIO_ENDPOINT}"
AWS_USE_PATH_STYLE_ENDPOINT=true

# Documents : limites upload
UPLOAD_MAX_SIZE_MB=20           # Taille max par fichier en Mo
UPLOAD_ALLOWED_MIMES=pdf,jpg,jpeg,png,docx
CANDIDATE_STORAGE_QUOTA_MB=500  # Quota stockage par candidat en Mo

# ─── Recherche (Meilisearch) ─────────────────────────────────────────
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true                # Indexation asynchrone via queue
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=                # ⚠️  Clé master Meilisearch

# ─── Antivirus (ClamAV) ──────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=true             # false en dev pour désactiver le scan

# ─── Authentification & Sécurité ─────────────────────────────────────
# 2FA (TOTP — Google Authenticator)
TWO_FACTOR_ENABLED=true
TWO_FACTOR_WINDOW=1             # Tolérance en fenêtres de 30s (1 = 30s)

# Magic Link (connexion admin sans mot de passe)
MAGIC_LINK_EXPIRY_MINUTES=15

# Invitation admin ambassade
INVITATION_EXPIRY_HOURS=48

# Rate limiting
AUTH_THROTTLE_MAX_ATTEMPTS=5
AUTH_THROTTLE_DECAY_MINUTES=1

# reCAPTCHA v3
RECAPTCHA_ENABLED=false         # ⚠️  true en production
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5

# ─── Monitoring (Grafana/Prometheus) ─────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=               # ⚠️  Mot de passe Grafana fort

# ─── Nginx ───────────────────────────────────────────────────────────
NGINX_SERVER_NAME=localhost     # ⚠️  Votre nom de domaine en production

# ─── Telescope (dev uniquement) ──────────────────────────────────────
TELESCOPE_ENABLED=false         # ⚠️  TOUJOURS false en production

# ─── RGPD ────────────────────────────────────────────────────────────
DPO_EMAIL=dpo@asd.dz            # Email du Délégué à la Protection des Données
GDPR_DATA_EXPORT_EXPIRY_HOURS=24  # Durée de validité des liens d'export

# ─── Maintenance ─────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_SECRET=         # ⚠️  Secret pour bypass maintenance (php artisan down --secret=xxx)
